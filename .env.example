PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 可选:允许跨域的来源(逗号分隔,如 https://example.com)
# 默认不开启 CORS(同源部署);仅在确有跨域调用需求时配置
CORS_ORIGIN=

# rclone 已内置在镜像中(固定 v1.75.1),无需在宿主机安装,以下一般无需修改
# 容器内 rclone 可执行文件路径
#RCLONE_PATH=/usr/bin/rclone
# rclone 配置文件路径(持久化于 ./config/rclone,由 Web UI「后处理 → rclone」自动生成/更新)
#RCLONE_CONFIG=/config/rclone/rclone.conf
